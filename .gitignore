node_modules/
.next/
out/
build/
dist/

.env
.env.local
.env*.local

# Os segredos de produção. `.env*.local` acima NÃO pega `.env.producao`, e a
# diferença custaria caro: a senha do banco, o segredo que assina as sessões e o
# JOBS_SECRET num commit ficam no histórico para sempre, mesmo depois de
# apagados do arquivo. A linha de exemplo versionada é `.env.producao.example`,
# com os valores em branco.
.env.producao
.env.producao.*
!.env.producao.example

# Os backups do banco. Um dump carrega os dados de TODOS os tenants em claro —
# chamados, clientes, contratos. É o arquivo que menos pode entrar num
# repositório, e o `BACKUP_DIR` padrão do compose de produção aponta para cá.
backups/
*.dump

.DS_Store
*.pem
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

coverage/
*.tsbuildinfo
next-env.d.ts

supabase/.branches
supabase/.temp

# Binários e pacotes do agente (agente/empacotamento/construir.sh).
# São artefatos de publicação: versionados num release, não no repositório.
agente/dist/

# Modo local (docs/22): banco de desenvolvimento e anexos em disco.
.local-storage/

# Scripts de captura de tela, criados fora do repositório durante o trabalho.
.tirar.mjs
.f3*.mjs
