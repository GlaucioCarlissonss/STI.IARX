# =============================================================================
# Variáveis de ambiente — copie para .env.local e preencha
# =============================================================================

# --- Supabase (obrigatório) --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Chave de serviço. Usada APENAS em três pontos auditáveis (ADR-011 + emenda):
#   1. rota /tv/[token] — resolve o token de exibição sem sessão de usuário
#   2. Edge Functions de integração
#   3. os trabalhos agendados (migração 0030) — um trabalho que roda às três da
#      manhã não tem sessão de usuário por definição
# NUNCA prefixe com NEXT_PUBLIC_: isso a exporia no bundle do navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Endereço público do sistema. Entra no link de recuperação de senha e no link
# da pesquisa de satisfação. É variável, e não algo que o sistema descobre do
# cabeçalho da requisição: quem controlasse esse cabeçalho controlaria o destino
# do link, e o e-mail legítimo levaria a pessoa para o site de quem atacou.
NEXT_PUBLIC_SITE_URL=https://sti.SEU-DOMINIO.com.br

# --- Avisos por e-mail (docs/13) ---------------------------------------------
# Sem estas duas, o sistema funciona e NÃO manda e-mail: a caixa de saída
# (`email_outbox`) acumula e nada se perde. Quando a chave entrar, o acumulado
# sai. O silêncio fica visível em `job_runs`, não escondido.
#
# As duas são obrigatórias juntas: o Resend recusa remetente de domínio não
# verificado, e descobrir isso no primeiro envio de produção é descobrir tarde.
RESEND_API_KEY=
MAIL_FROM=

# --- Trabalhos agendados (docs/13) -------------------------------------------
# Segredo PRÓPRIO da rota POST /api/jobs/run, que fecha chamado e dispara
# e-mail. Separado de qualquer outra credencial de propósito. Gere com:
#   openssl rand -hex 32
# Sem esta variável a rota responde 503 — fechada, nunca aberta por esquecimento.
JOBS_SECRET=

# --- Autoatualização do agente de inventário (docs/14) -----------------------
# OPCIONAIS, e fechadas por padrão. Faltando qualquer uma das quatro, a rota
# GET /api/agent/version responde 204 (nada a fazer) e os agentes continuam na
# versão instalada — que é o estado seguro.
#
# O agente confere o SHA-256 **e** a assinatura Ed25519 dos bytes do binário
# contra uma chave pública compilada dentro dele. Sem chave compilada, ele RECUSA
# se atualizar. Isto é deliberadamente paranoico com o próprio servidor: se só o
# hash fosse conferido, quem controlasse estas variáveis controlaria o binário que
# roda como serviço em todas as máquinas do cliente.
#
# A chave PRIVADA que assina não entra aqui nem no repositório. É por ela ficar
# fora do servidor que a assinatura serve para alguma coisa.
#
# Como gerar e assinar: docs/14, seção 6.
AGENT_RELEASE_VERSION=
AGENT_RELEASE_URL=
AGENT_RELEASE_SHA256=
AGENT_RELEASE_SIGNATURE=
# Intervalo, em minutos, entre consultas de versão. Padrão 720 (12 h). Está aqui
# para o caso de emergência: subir este número pelo servidor é mais rápido que
# recompilar e redistribuir o agente.
AGENT_UPDATE_CHECK_MIN=

# --- Bitrix24 (ADR-009: aqui ficam os VALORES; o banco guarda só a referência) ---
# Incoming webhook do Bitrix24, usado para chamadas de volta (tasks.task.get/update).
# Formato: https://SEU.bitrix24.com.br/rest/<user-id>/<codigo-secreto>/
BITRIX24_INBOUND_WEBHOOK_URL=

# Token gerado pelo Bitrix24 ao criar o outgoing webhook. O banco guarda o hash;
# este é o valor em claro usado para comparação na Edge Function.
BITRIX24_APPLICATION_TOKEN=

# --- Mapas (Módulo 11) --------------------------------------------------------
# Sem nada configurado aqui, o mapa já funciona: motor OpenStreetMap/Esri
# (ruas + satélite, gratuitos, sem chave) e geocodificação por Nominatim
# (OpenStreetMap). As duas variáveis abaixo são OPCIONAIS — só para quem
# preferir o motor oficial do Google (SLA e suporte, exige conta Google Cloud).

# Opcional. Chave do NAVEGADOR para a Maps JavaScript API. É pública por
# natureza — a API valida por referrer, não por segredo. Restrinja-a ao seu
# domínio no console do Google, senão qualquer site consome sua cota.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Opcional. Chave de SERVIDOR para a Geocoding API, restrita por IP. Separada
# da anterior de propósito: chamar a Geocoding API do navegador exporia uma
# chave irrestrita.
GOOGLE_MAPS_SERVER_KEY=

# Opcional. User-Agent enviado ao Nominatim (OpenStreetMap) — a política de uso
# do serviço exige identificar a aplicação. Só importa se as chaves do Google
# acima estiverem vazias.
NOMINATIM_USER_AGENT=
