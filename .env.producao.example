# =============================================================================
# Produção — copie para `.env.producao` e preencha.
#
#     cp .env.producao.example .env.producao
#     docker compose -f compose.producao.yml --env-file .env.producao up -d
#
# `.env.producao` está no .gitignore. Se este arquivo um dia aparecer num
# `git status`, alguém tirou a linha de lá — e os segredos abaixo estão a um
# commit de virar públicos para sempre, inclusive no histórico.
#
# COMO GERAR OS SEGREDOS
# ----------------------
#     openssl rand -hex 32
#
# Um valor DIFERENTE para cada variável. Reaproveitar significa que quem
# descobrir um descobriu todos, e o motivo de eles serem separados some.
# =============================================================================

# --- Obrigatórios ------------------------------------------------------------

# O domínio, com https://. Precisa já apontar para o IP desta VPS ANTES de
# subir: a Let's Encrypt confere fazendo uma requisição de volta.
SITE_URL=https://sti.iarx.com.br

# A senha do PostgreSQL. O banco NÃO publica porta — só os contêineres desta
# rede o alcançam —, mas a senha continua sendo o que separa um contêiner
# comprometido do banco inteiro.
POSTGRES_PASSWORD=

# Assina o cookie de sessão. Trocar este valor desloga todo mundo de uma vez,
# o que é exatamente o que se quer fazer num incidente.
LOCAL_AUTH_SECRET=

# Segredo PRÓPRIO da rota POST /api/jobs/run, que fecha chamado e dispara
# e-mail. Separado de qualquer outra credencial de propósito. Sem ele a rota
# responde 503 — fechada, nunca aberta por esquecimento.
JOBS_SECRET=

# --- Opcionais ---------------------------------------------------------------

# Tempera o hash do IP usado pelo limite de requisições das telas públicas
# (migração 0059). O endereço NUNCA é gravado — o banco só vê o hash.
#
# Opcional porque, faltando, o sistema cai para LOCAL_AUTH_SECRET e depois para
# JOBS_SECRET. Sem nenhum dos três o limite CONTINUA valendo; o que se perde é a
# irreversibilidade do hash — um SHA-256 de IPv4 sem tempero se quebra por força
# bruta em minutos, porque são só quatro bilhões de possibilidades.
#
# Trocar este valor zera os contadores em curso, o que é inofensivo.
LIMITE_ORIGEM_PEPPER=

POSTGRES_DB=sti_iarx

# Onde os backups caem, no HOST. Um caminho de VOLUME do Docker seria apagado
# por um `docker compose down -v` digitado com pressa — que é o momento em que
# o backup mais importa.
BACKUP_DIR=./backups

# De quanto em quanto tempo o agendador chama os trabalhos. 300 s (5 min) é o
# padrão, e as tolerâncias do alerta de trabalho parado (migração 0055) foram
# escolhidas supondo esse ritmo. Se mudar muito daqui, ajuste
# `job_expectations.tolerancia_min` junto — senão o alerta toca à toa, e alerta
# que toca à toa deixa de ser lido.
JOBS_INTERVALO_SEG=300

# --- E-mail --------------------------------------------------------------
#
# Sem provedor o sistema roda e NÃO manda e-mail: a caixa de saída acumula e
# nada se perde. Mas confirmação de cadastro, convite e redefinição de senha
# dependem dele — sem e-mail, a entrada pública não funciona.
#
# `MAIL_FROM` é obrigatório nos dois caminhos. O Resend recusa remetente de
# domínio não verificado; um servidor SMTP recusa remetente que não é da caixa
# autenticada. Descobrir isso no primeiro envio de produção é descobrir tarde.
MAIL_FROM=

# CAMINHO 1 — SMTP, para quem já tem caixa de e-mail (Hostinger, Zoho, Google
# Workspace). Não exige serviço novo nem verificação de domínio por DNS.
#
# A PORTA DECIDE O MODO, e trocá-los é o tropeço mais comum: 465 é TLS desde o
# primeiro byte, 587 e 25 começam em claro e sobem com STARTTLS. Errar dá
# "wrong version number" ou uma espera sem mensagem nenhuma.
#
# Na Hostinger: smtp.hostinger.com, porta 465, usuário = o endereço completo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
# Só para contrariar o padrão da porta. Em branco, 465 é seguro e o resto usa
# STARTTLS — que é o certo em praticamente todo servidor.
SMTP_SEGURO=

# CAMINHO 2 — Resend. Menor atrito para começar, exige verificar o domínio no
# serviço deles. Se os dois estiverem preenchidos, o SMTP ganha: configurá-lo dá
# mais trabalho, então quem o fez, fez de propósito.
RESEND_API_KEY=

# Para onde avisar quando um trabalho agendado parar ou passar a falhar.
# Independentes: configure um, os dois, ou nenhum. O aviso sai uma vez por
# episódio (a quebra) e uma na volta.
ALERTA_OPERACAO_EMAIL=
ALERTA_OPERACAO_WEBHOOK=
